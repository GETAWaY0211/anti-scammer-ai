{
  "scoring_version": "1.1.0",
  "taxonomy_version": "1.1.0",
  "description": "Deterministic risk scoring for Anti-Scammer AI with backend-derived database intelligence indicators. Severity and weight remain independent explicit configuration values.",
  "score_range": {
    "min": 0,
    "max": 100
  },
  "final_score_cap": 100,
  "risk_levels": [
    {
      "level": "low",
      "min": 0,
      "max": 29
    },
    {
      "level": "medium",
      "min": 30,
      "max": 59
    },
    {
      "level": "high",
      "min": 60,
      "max": 79
    },
    {
      "level": "critical",
      "min": 80,
      "max": 100
    }
  ],
  "human_review": {
    "confidence_below": 0.65,
    "unsupported_indicator": true,
    "conflicting_evidence": true,
    "quality_indicator_codes": [
      "LOW_IMAGE_QUALITY",
      "LOW_AUDIO_QUALITY"
    ],
    "always_review_indicator_codes": [
      "INSUFFICIENT_CONTEXT",
      "REPORTED_SUSPICIOUS_ENTITY"
    ],
    "possible_prompt_injection": false,
    "invalid_confidence": true,
    "malformed_supported_indicator": true,
    "severity_mismatch": true
  },
  "specificity_rules": [
    {
      "generic_code": "CREDENTIAL_REQUEST",
      "prefer_codes": [
        "OTP_REQUEST",
        "PASSWORD_REQUEST",
        "CARD_DATA_REQUEST",
        "VERIFICATION_CODE_FORWARDING"
      ],
      "evidence_match": "normalized_equal_or_containment",
      "description": "Suppress the generic credential request when a more specific credential indicator describes the same evidence."
    }
  ],
  "scoring_groups": [
    {
      "id": "credential_access",
      "description": "Credential, identity, card, and account-access requests.",
      "score_cap": 75,
      "members": [
        "OTP_REQUEST",
        "PASSWORD_REQUEST",
        "CREDENTIAL_REQUEST",
        "CARD_DATA_REQUEST",
        "IDENTITY_DATA_REQUEST",
        "VERIFICATION_CODE_FORWARDING"
      ]
    },
    {
      "id": "financial_request",
      "description": "Payment requests and movement of money.",
      "score_cap": 70,
      "members": [
        "PAYMENT_REQUEST",
        "URGENT_PAYMENT",
        "ADVANCE_FEE_REQUEST",
        "UNUSUAL_PAYMENT_METHOD",
        "MONEY_MULE_REQUEST",
        "REFUND_OVERPAYMENT"
      ]
    },
    {
      "id": "pressure_manipulation",
      "description": "Urgency, threats, secrecy, isolation, and emotional pressure.",
      "score_cap": 45,
      "members": [
        "URGENCY_PRESSURE",
        "THREAT_OR_INTIMIDATION",
        "SECRECY_REQUEST",
        "ISOLATION_FROM_TRUSTED_CONTACTS",
        "EMOTIONAL_MANIPULATION",
        "SCARCITY_PRESSURE"
      ]
    },
    {
      "id": "impersonation",
      "description": "Claims of false organizational, authority, executive, or contact identity.",
      "score_cap": 45,
      "members": [
        "BANK_IMPERSONATION",
        "GOVERNMENT_IMPERSONATION",
        "COMPANY_IMPERSONATION",
        "EXECUTIVE_IMPERSONATION",
        "KNOWN_CONTACT_IMPERSONATION",
        "FAKE_AUTHORITY_CLAIM"
      ]
    },
    {
      "id": "device_access",
      "description": "Suspicious links, application installation, and device-control requests.",
      "score_cap": 80,
      "members": [
        "SUSPICIOUS_LINK",
        "URL_SHORTENER",
        "APK_INSTALL_REQUEST",
        "REMOTE_ACCESS_REQUEST",
        "SCREEN_SHARE_REQUEST",
        "DISABLE_SECURITY_REQUEST",
        "MOVE_OFF_PLATFORM"
      ]
    },
    {
      "id": "investment_earnings",
      "description": "Investment, task, recruitment, job, and earnings patterns.",
      "score_cap": 70,
      "members": [
        "GUARANTEED_RETURN",
        "UNREALISTIC_RETURN",
        "PAY_TO_UNLOCK_EARNINGS",
        "TASK_RECHARGE_REQUEST",
        "FAKE_JOB_FEE",
        "PRESSURE_TO_RECRUIT"
      ]
    },
    {
      "id": "commerce_delivery",
      "description": "Delivery, marketplace, prize, and escrow patterns.",
      "score_cap": 60,
      "members": [
        "FAKE_DELIVERY_FEE",
        "OFF_PLATFORM_PAYMENT",
        "PRIZE_FEE_REQUEST",
        "UNSOLICITED_PRIZE",
        "FAKE_ESCROW_OR_MIDDLEMAN"
      ]
    },
    {
      "id": "database_intelligence",
      "description": "Authoritative backend-derived matches from the trusted scam-entity intelligence database.",
      "score_cap": 80,
      "members": [
        "KNOWN_SCAM_PHONE",
        "KNOWN_SCAM_BANK_ACCOUNT",
        "KNOWN_SCAM_DOMAIN",
        "REPORTED_SUSPICIOUS_ENTITY"
      ]
    }
  ],
